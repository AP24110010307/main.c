#include <stdio.h>

int main() {
    double height = 10.0;      // initial height (meters)
    double velocity = 0.0;     // initial velocity
    double g = -9.8;           // gravity (m/s^2)
    double dt = 0.01;          // time step
    double bounce = 0.7;       // energy lost on each bounce

    for (double t = 0; t < 5; t += dt) {
        velocity += g * dt;     // update velocity
        height += velocity * dt; // update height
        
        // Bounce condition
        if (height <= 0) {
            height = 0;
            velocity = -velocity * bounce;  // reverse and reduce speed
        }

        printf("t=%.2f s, height=%.2f m\n", t, height);
    }

    return 0;
}
